# Yard Dog service configuration (read by yd.service).
# Names are unprefixed — this file is scoped to the yd.service unit.

# Directory holding your compose stacks (the versioned monorepo root).
ROOT=/srv/stacks

# Loopback port for the browser control plane.
PORT=8770

# Where recovery points live. Empty ⇒ each stack's own .yd-backups (same disk as
# the data). Set to a directory on a separate volume (e.g. a NAS mount) to keep
# backups off the data's disk: <BACKUP_ROOT>/<stack-name>. Read by `yd serve`.
BACKUP_ROOT=

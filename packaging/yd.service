[Unit]
Description=Yard Dog loopback control plane
Documentation=https://github.com/williamweatherholtz/yard_dog
After=docker.service
Wants=docker.service

[Service]
Type=simple
# Edit /etc/yard-dog/yd.env to point YD_ROOT at your stacks directory, then:
#   sudo systemctl enable --now yd
EnvironmentFile=/etc/yard-dog/yd.env
ExecStart=/usr/bin/yd serve --root ${YD_ROOT} --port ${YD_PORT}
Restart=on-failure
RestartSec=3
# yd binds 127.0.0.1 only; expose it via your own SSH tunnel / reverse proxy.

[Install]
WantedBy=multi-user.target
